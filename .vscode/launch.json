{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "program": "${workspaceFolder}/sample/node_editor.py",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "cwd": "${workspaceFolder}/sample",
            "justMyCode": false,
            "args": []
        },
        {
            "name": "DebugMem",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "program": "${workspaceFolder}/venv/bin/mprof",
            "env": {
                "MPLBACKEND": "module://backend_interagg",
                "PYTHONPATH": "${workspaceFolder}"
            },
            "cwd": "${workspaceFolder}/sample",
            "justMyCode": false,
            "args": [
                "run",
                "node_editor.py"
            ],
        },
        {
            "name": "MemPlot",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "program": "${workspaceFolder}/venv/bin/mprof",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "cwd": "${workspaceFolder}/sample",
            "justMyCode": false,
            "args": [
                "plot"
            ],
        },
    ]
}